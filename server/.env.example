# Kopiera till .env för lokal körning (eller sätt som miljövariabler i Railway).

# Postgres-anslutning från Supabase (Project Settings → Database → Connection string → URI).
# Använd "Connection pooling"-strängen (port 6543) och byt ut [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:6543/postgres

# Vilka webbplatser som får skicka resultat (kommaseparerat). Lämna som * under test.
ALLOWED_ORIGINS=https://games.nordhammer.se

# PORT sätts automatiskt av Railway. Lokalt används 3000 om den saknas.

# Ghost Trains: skyddar den manuella /api/ghosttrains/resolve-endpointen
# (kräver header x-resolve-secret). Lämna tom för att tillåta anrop utan
# hemlighet (t.ex. under lokal utveckling). Den nattliga cron-körningen
# behöver ingen hemlighet — den kör in-process.
GHOSTTRAINS_RESOLVE_SECRET=

# Flashback: API-nyckel från console.anthropic.com (Settings → API Keys),
# skild från ett vanligt Claude-abonnemang. Används av den veckovisa
# cron-genereringen (måndag natt) för att skapa nästa veckas pussel.
# Saknas den genereras inga nya pussel (servern loggar en varning).
ANTHROPIC_API_KEY=

# Flashback: skyddar den manuella /api/flashback/generate-endpointen
# (kräver header x-generate-secret). Lämna tom för att tillåta anrop utan
# hemlighet (t.ex. under lokal utveckling). Den veckovisa cron-körningen
# behöver ingen hemlighet — den kör in-process.
FLASHBACK_GENERATE_SECRET=

# Kalendern (Nattåget, Halloween …; se kalender/SPEC.md):
# CONTENT_KEY: base64, 32 byte — dekrypterar server/kalender/<id>.enc.
#   Samma nyckel för alla kalendrar. Saknas den svarar spelet 503
#   "Kalendern är inte redo än" (om inte testinnehållet används).
# KALENDER_ACTIVE: id för den aktiva kalendern, t.ex. halloween-2026.
# KALENDER_CONTENT: "sample" = använd testinnehållet (server/kalender/sample.json).
#   Det enda sättet att få testinnehåll. Använd alltid lokalt.
# KALENDER_SAMPLE_START: ÅÅÅÅ-MM-DD. Flyttar testinnehållets startdatum, så
#   att testluckorna går att öppna på riktigt (även i produktion). Bara med
#   KALENDER_CONTENT=sample.
# Finns CONTENT_KEY och den aktiva kalenderns .enc-fil används ALLTID det
#   riktiga innehållet, och KALENDER_CONTENT / KALENDER_SAMPLE_START ignoreras
#   (varning i loggen).
# KALENDER_ADMIN_SECRET: skyddar /api/kalender/admin/*. Tom = admin avstängt.
# KALENDER_FAKE_NOW: ISO-tid, t.ex. 2026-10-27T10:00:00+01:00. Bara lokalt —
#   ignoreras när NODE_ENV=production.
# De gamla namnen NATTAGET_* läses som reserv (med varning) tills de döpts om.
CONTENT_KEY=
KALENDER_ACTIVE=
KALENDER_CONTENT=
KALENDER_SAMPLE_START=
KALENDER_ADMIN_SECRET=
KALENDER_FAKE_NOW=
